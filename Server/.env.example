# --- Required ---
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/flashshop
JWT_SECRET=change-me-long-random-string
PORT=10000
# Client origins allowed by CORS, comma-separated
CLIENT_URL=https://flaash.co.il,https://www.flaash.co.il
NODE_ENV=production

# --- Emails (Gmail App Password) ---
EMAIL_USER=shop@example.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_HOST=smtp.gmail.com

# --- Optional ---
BCRYPT_SALT=10
GEMINI_API_KEY=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_PUBLIC_LINKS=
