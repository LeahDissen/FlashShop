# --- Required ---
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/flashshop
JWT_SECRET=change-me-long-random-string
PORT=10000
# Client origins allowed by CORS, comma-separated
CLIENT_URL=https://flaash.co.il,https://www.flaash.co.il
NODE_ENV=production

# --- Emails (Gmail App Password) ---
EMAIL_USER=shop@example.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Railway blocks SMTP on the Free/Trial/Hobby plans. There, mail is sent through an email provider's HTTP API:
# EMAIL_PROVIDER=brevo          # brevo | resend (empty = SMTP with EMAIL_USER/EMAIL_PASS)
# EMAIL_API_KEY=
# EMAIL_FROM=shop@flaash.co.il  # sender address verified with the provider
# EMAIL_FROM_NAME=Flash

# --- Optional ---
BCRYPT_SALT=10
GEMINI_API_KEY=
# Cloudinary "API environment variable" (cloudinary://key:secret@cloud). Deletes customers' photos 30 days after printing
CLOUDINARY_URL=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_PUBLIC_LINKS=

# --- One-time: import page content from the old CMS server (npm run import:pages) ---
# CMS_URL=https://flashshop-redis.onrender.com
