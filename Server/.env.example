# --- חובה ---
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/flashshop
JWT_SECRET=change-me-long-random-string
PORT=10000
# כתובות הלקוח המורשות ל-CORS, מופרדות בפסיק
CLIENT_URL=https://flaash.co.il,https://www.flaash.co.il
NODE_ENV=production

# --- מיילים (Gmail App Password) ---
EMAIL_USER=shop@example.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Railway חוסם SMTP בתוכניות Free/Trial/Hobby. שם שולחים דרך HTTP API של ספק מייל:
# EMAIL_PROVIDER=brevo          # brevo | resend (ריק = SMTP עם EMAIL_USER/EMAIL_PASS)
# EMAIL_API_KEY=
# EMAIL_FROM=shop@flaash.co.il  # כתובת שולח מאומתת אצל הספק
# EMAIL_FROM_NAME=פלאש

# --- אופציונלי ---
BCRYPT_SALT=10
GEMINI_API_KEY=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_PUBLIC_LINKS=

# --- חד-פעמי: ייבוא תוכן הדפים משרת ה-CMS הישן (npm run import:pages) ---
# CMS_URL=https://flashshop-redis.onrender.com
