{
  // Cloudflare Workers (static assets) – מגיש את ה-build של Vite כ-SPA.
  // deploy: npm run build && npx wrangler deploy
  "name": "flaash",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true
}
